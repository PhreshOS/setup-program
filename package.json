{
    "name": "setup",
    "private": true,
    "version": "0.1.3",
    "description": "The official PhreshOS welcome and initial setup Program.",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "check": "tsc --noEmit",
        "build": "vite-node --config vite.server.ts source/build.ts",
        "dev": "phresh dev",
        "start": "phresh start",
        "pack": "phresh pack",
        "verify": "node --run check && node --run build && vite-node scripts/verify-build.mjs"
    },
    "author": "Zohayr SLILEH",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PhreshOS/setup-program.git"
    },
    "bugs": {
        "url": "https://github.com/PhreshOS/setup-program/issues"
    },
    "homepage": "https://github.com/PhreshOS/setup-program#readme",
    "keywords": [
        "phreshos",
        "program",
        "setup"
    ],
    "dependencies": {
        "@phreshos/client": "^0.1.4",
        "@phreshos/core": "^0.1.4",
        "@phreshos/server": "^0.1.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@phreshos/cli": "^0.1.10",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vite-node": "^6.0.0"
    }
}
